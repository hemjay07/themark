# Jupiter API key (free tier from portal.jup.ag). Optional: without it the app runs at half the
# request rate. Server-side only; it never reaches the browser.
JUPITER_API_KEY=your-jupiter-api-key

# A private Solana RPC URL. Optional: without it the app rotates between two public endpoints.
SOLANA_RPC_URL=https://your-rpc-provider.example/your-key
